{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SunnyLimc/libmpv-runtime/contracts/validation-index.schema.json",
  "title": "libmpv-runtime complete validation index",
  "type": "object",
  "required": ["schemaVersion", "repositoryRevision", "planSha256", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
