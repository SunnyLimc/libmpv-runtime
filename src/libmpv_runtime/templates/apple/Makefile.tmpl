RUNTIME_URL?=@@URL@@
RUNTIME_SHA256?=@@SHA256@@
RUNTIME_CACHE=.cache/runtime-$(RUNTIME_SHA256).tar.gz
RUNTIME_STAMP=Frameworks/.runtime-$(RUNTIME_SHA256)
SYMLINK_STAMP=Frameworks/.symlinks/.runtime-$(RUNTIME_SHA256)
all: $(RUNTIME_STAMP) $(SYMLINK_STAMP)
$(RUNTIME_CACHE):
	mkdir -p .cache
	curl --fail --location --retry 3 --connect-timeout 30 "$(RUNTIME_URL)" -o "$@.tmp"
	printf '%s  %s\n' '$(RUNTIME_SHA256)' '$@.tmp' | shasum -a 256 -c -
	mv "$@.tmp" "$@"
$(RUNTIME_STAMP): $(RUNTIME_CACHE)
	rm -rf Frameworks
	mkdir -p Frameworks
	tar -xzf "$(RUNTIME_CACHE)" -C Frameworks
	touch "$@"
$(SYMLINK_STAMP): $(RUNTIME_STAMP)
	rm -rf Frameworks/.symlinks
	mkdir -p Frameworks/.symlinks/mpv
	sh create_framework_symlinks.sh Frameworks/Mpv.xcframework Frameworks/.symlinks/mpv
	touch "$@"
clean:
	rm -rf .cache Frameworks
.PHONY: all clean
