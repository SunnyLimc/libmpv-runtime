diff --git a/Makefile b/Makefile
index d809c74..fc16075 100644
--- a/Makefile
+++ b/Makefile
@@ -19,7 +19,10 @@ all: build
 # After the build, .nix/config/xcode.path and .nix/config/version.txt are
 # restored to their committed values.
 .PHONY: build
 build:
-	trap 'git checkout -- .nix/config/xcode.path .nix/config/version.txt' EXIT; \
+	cp .nix/config/xcode.path .nix/config/xcode.path.libmpv-runtime-backup; \
+	cp .nix/config/version.txt .nix/config/version.txt.libmpv-runtime-backup; \
+	trap 'mv .nix/config/xcode.path.libmpv-runtime-backup .nix/config/xcode.path; \
+	      mv .nix/config/version.txt.libmpv-runtime-backup .nix/config/version.txt' EXIT; \
 	$(if $(XCODE_PATH),echo '$(XCODE_PATH)' > .nix/config/xcode.path;,) \
 	$(if $(VERSION),echo '$(VERSION)' > .nix/config/version.txt;,) \
 	nix build -v -L \
