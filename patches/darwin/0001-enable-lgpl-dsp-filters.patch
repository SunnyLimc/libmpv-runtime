diff --git a/nix/packages/mk-pkg-ffmpeg/meson.build b/nix/packages/mk-pkg-ffmpeg/meson.build
index cb3d47a..ab5f98f 100644
--- a/nix/packages/mk-pkg-ffmpeg/meson.build
+++ b/nix/packages/mk-pkg-ffmpeg/meson.build
@@ -55,12 +55,25 @@ common_options = [
     '--enable-avformat',
     '--enable-swresample',
     '--enable-swscale',
     '--enable-avfilter',
+    '--disable-gpl',
+    '--disable-nonfree',
 
     # '--enable-gpl', # uncomment it to include GPL code
     # '--enable-nonfree', # uncomment it to include unredistributable code
 ]
 
+dsp_filter_options = [
+    '--enable-filter=loudnorm',
+    '--enable-filter=dynaudnorm',
+    '--enable-filter=acompressor',
+    '--enable-filter=alimiter',
+    '--enable-filter=volume',
+    '--enable-filter=aresample',
+    '--enable-filter=ebur128',
+    '--enable-filter=astats',
+]
+
 audio_common_options = [
     '--enable-zlib', # rasc support
     '--enable-audiotoolbox',
@@ -312,6 +323,7 @@ options = disable_all_options
 
 # common
 options += common_options
+options += dsp_filter_options
 options += audio_common_options
 if variant == 'video'
     options += video_common_options
